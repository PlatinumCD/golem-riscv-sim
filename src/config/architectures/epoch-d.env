# Corrected physical-word network baseline.
#
# Epoch D retains Epoch C's validated CPU, analog, memory, and synchronization
# models while separating the 32-bit physical timing cell from router buffer
# capacity. Epoch C remains frozen for historical reproducibility.
EPOCH_NAME=physical-word-network-baseline
EPOCH_VERSION=D
EPOCH_FREEZE_DATE=2026-07-30
PROJECT_REVISION=commit-containing-this-manifest
UPSTREAM_VERSION_MANIFEST=src/config/versions.env

# Compiler and workload construction.
COMPILER_PIPELINE_VERSION=backend-aware-v1
CORE_REGISTER_ALLOCATOR=basic
CORE_LTO=none
RANDOM_SEED=0
REDUCTION_WIDTH=2

# CPU and QEMU synchronization.
CPU_CLOCK=1GHz
CPU_ISSUE_WIDTH=2
RISCV_VECTOR_VERSION=1.0
RISCV_VECTOR_VLEN_BITS=256
RISCV_VECTOR_ELEN_BITS=64
VECTOR_ISSUE_INSTRUCTIONS_PER_CYCLE=1
DIGITAL_VECTOR_BITS_PER_CYCLE=256
# Fixed co-simulation temporal-lookahead bound. It is part of the modeled
# configuration until receive-side observation is made event exact.
SYNC_INSTRUCTION_QUANTUM=1000000

# Tile and mesh.
MESH_WIDTH=8
MESH_HEIGHT=8
TILE_MEMORY=64M
MEMORY_BACKEND=native
MESH_LINK_CLOCK=1GHz
MESH_LINK_WIDTH_BITS=32
MESH_LINK_LATENCY=10ns
NETWORK_CELL_WORDS=1
NETWORK_BUFFER_CELLS=16384

# Receive DMA.
RX_DMA_CLOCK=1GHz
RX_DMA_WIDTH_BITS=256
RX_DMA_SETUP_CYCLES=8
RX_DMA_QUEUE_DEPTH=4

# Analog accelerator.
ANALOG_BACKEND=native
ANALOG_ARRAYS_PER_TILE=4
ANALOG_ARRAY_ROWS=1024
ANALOG_ARRAY_COLUMNS=512
ANALOG_LINK_CLOCK=1GHz
ANALOG_LINK_WIDTH_BITS=256
ANALOG_LINKS_PER_TILE=1
ANALOG_COMPUTE_LATENCY_CYCLES=8

# Optional private-L1 study configuration.
PRIVATE_L1_CAPACITY=32KiB
PRIVATE_L1_ASSOCIATIVITY=4
PRIVATE_L1_LINE_BYTES=64
PRIVATE_L1_REPLACEMENT=LRU
PRIVATE_L1_CLOCK=1GHz
PRIVATE_L1_LOOKUP_CYCLES=2
PRIVATE_L1_LINK_LATENCY=1ns
PRIVATE_L1_LOWER_MEMORY_LATENCY=50ns
MEMORY_INIT_BYTES_PER_CYCLE=32
MEMORY_INIT_LATENCY_CYCLES=2

# Component evidence inherited from Epoch C and the new placement-distance
# regression that exposed and validates the corrected deployment setting.
CPU_VALIDATION=tests/platform/cpu-timing/run-test.sh
NETWORK_VALIDATION=tests/network/timing/run-test.sh
ANALOG_VALIDATION=tests/analog/timing/run-test.sh
MEMORY_VALIDATION=tests/memory/scratchpad-dma/run-test.sh
TRANSMIT_VALIDATION=tests/network/transmit-fanout/run-test.sh
PLACEMENT_DISTANCE_VALIDATION=tests/analog/producer-mvm-recombine-distance/run-test.sh
