diff --git a/accel/tcg/cputlb.c b/accel/tcg/cputlb.c
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -1543,6 +1543,41 @@
 #ifdef TARGET_RISCV
 /* Nonfaulting preflight only: unlike probe_access_flags, do not dirty RAM or
  * invalidate translated code before the corresponding SST timing grant. */
+/* Pure translation preflight for a deferred LSQ instruction. No grant,
+ * functional access, dirtying, or instruction-cache invalidation occurs. */
+bool mittens_sync_lsq_memory_probe(
+    void *cpu_env, uint64_t address, uint32_t size, uint32_t element_size,
+    bool write, uintptr_t retaddr, uint64_t *physical_address)
+{
+    CPUArchState *env = cpu_env;
+    CPUState *cpu = env_cpu(env);
+    CPUTLBEntryFull *full;
+    void *host;
+    const MMUAccessType access = write ? MMU_DATA_STORE : MMU_DATA_LOAD;
+    if (!mittens_sync_lsq_enabled() || !size || !element_size ||
+        address % element_size || size % element_size ||
+        size > TARGET_PAGE_SIZE - (address & ~TARGET_PAGE_MASK)) {
+        return false;
+    }
+    const int flags = probe_access_internal(cpu, address, size, access,
+        cpu_mmu_index(env, false), true, &host, &full, retaddr, true);
+    if ((flags & ~TLB_NOTDIRTY) || !host || !full ||
+        full->lg_page_size < TARGET_PAGE_BITS) {
+        return false;
+    }
+    if (write && (flags & TLB_NOTDIRTY) &&
+        !cpu_physical_memory_get_dirty_flag(address + full->xlat_section,
+                                           DIRTY_MEMORY_CODE)) {
+        return false;
+    }
+    const uint64_t physical = full->phys_addr + (address & ~TARGET_PAGE_MASK);
+    if (!mittens_sync_scratchpad_host_matches(host, physical, size)) {
+        return false;
+    }
+    *physical_address = physical;
+    return true;
+}
+
 bool mittens_sync_vector_memory_probe(
