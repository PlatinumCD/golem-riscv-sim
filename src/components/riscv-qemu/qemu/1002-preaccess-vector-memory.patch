+/* Preauthorize one contiguous physical-SPM beat, before any element access.
+ * A beat is at most one architectural vector-register width, even with LMUL
+ * groups or whole-register instructions. Mask holes, pages, and VL bound it.
+ * Unsupported mappings retain QEMU's original per-element fault/vstart path. */
+static uint32_t vext_mittens_preaccess(CPURISCVState *env, void *v0, bool vm,
+                                     target_ulong base, uint32_t first,
+                                     uint32_t limit, vext_ldst_elem_fn *elem,
+                                     uint32_t log2_esz, uintptr_t ra)
+{
+#ifndef CONFIG_USER_ONLY
+    const uint32_t esz = 1u << log2_esz;
+    const target_ulong addr = adjust_addr(env, base + ((target_ulong)first << log2_esz));
+    const uint32_t vlenb = riscv_cpu_cfg(env)->vlen >> 3;
+    uint32_t count;
+    bool write;
+
+    if (!mittens_sync_vector_memory_enabled() || addr % esz || first >= limit) {
+        return first;
+    }
+    count = MIN(limit - first, vlenb >> log2_esz);
+    count = MIN(count, (TARGET_PAGE_SIZE - (addr & ~TARGET_PAGE_MASK)) >> log2_esz);
+    if (!vm) {
+        uint32_t active = 0;
+        while (active < count && vext_elem_mask(v0, first + active)) {
+            active++;
+        }
+        count = active;
+    }
+    if (!count || adjust_addr(env, base + (((target_ulong)first + count) << log2_esz) - 1)
+                  != addr + ((target_ulong)count << log2_esz) - 1) {
+        return first;
+    }
+    write = elem == ste_b || elem == ste_h || elem == ste_w || elem == ste_d;
+    if (mittens_sync_vector_memory_probe(env, addr, count << log2_esz,
+                                        esz, write, ra)) {
+        return first + count;
+    }
+#endif
+    return first;
+}
