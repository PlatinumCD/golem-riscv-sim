+#ifdef TARGET_RISCV
+/* Nonfaulting preflight only: unlike probe_access_flags, do not dirty RAM or
+ * invalidate translated code before the corresponding SST timing grant. */
+bool mittens_sync_vector_memory_probe(
+    void *cpu_env, uint64_t address, uint32_t size, uint32_t element_size,
+    bool write, uintptr_t retaddr)
+{
+    CPUArchState *env = cpu_env;
+    CPUState *cpu = env_cpu(env);
+    CPUTLBEntryFull *full;
+    void *host;
+    int flags;
+    const MMUAccessType access = write ? MMU_DATA_STORE : MMU_DATA_LOAD;
+
+    if (!mittens_sync_vector_memory_enabled() || !size || !element_size ||
+        address % element_size || size % element_size ||
+        size > TARGET_PAGE_SIZE - (address & ~TARGET_PAGE_MASK)) {
+        return false;
+    }
+    flags = probe_access_internal(cpu, address, size, access,
+                                  cpu_mmu_index(env, false), true,
+                                  &host, &full, retaddr, true);
+    /* Invalid/PMP subpage mappings, MMIO, watchpoints, byteswaps and discarded
+     * writes require the original architectural element path. */
+    if ((flags & ~TLB_NOTDIRTY) || !host || !full ||
+        full->lg_page_size < TARGET_PAGE_BITS) {
+        return false;
+    }
+    if (write && (flags & TLB_NOTDIRTY) &&
+        !cpu_physical_memory_get_dirty_flag(address + full->xlat_section,
+                                           DIRTY_MEMORY_CODE)) {
+        /* Self-modifying-code handling can exit the helper. Do not hold a
+         * multi-element authorization across that potentially faulting path. */
+        return false;
+    }
+    return mittens_sync_vector_memory_begin(
+        host, full->phys_addr + (address & ~TARGET_PAGE_MASK), size,
+        element_size, write, mittens_sync_guest_pc(cpu, retaddr),
+        mittens_sync_guest_return_address(cpu));
+}
+#endif
