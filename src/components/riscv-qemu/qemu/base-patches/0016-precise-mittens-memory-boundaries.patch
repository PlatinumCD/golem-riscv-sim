diff --git a/target/riscv/translate.c b/target/riscv/translate.c
--- a/target/riscv/translate.c
+++ b/target/riscv/translate.c
@@ -1229,7 +1230,22 @@ static bool is_mittens_vector_instruction(
     return (primary_opcode == 0x07 || primary_opcode == 0x27) &&
            (width == 0 || width >= 5);
 }
 
+bool mittens_sync_memory_timing_enabled(void);
+static bool is_mittens_memory_instruction(uint32_t opcode)
+{
+    switch (extract32(opcode, 0, 7)) {
+    case 0x03: /* integer load */
+    case 0x07: /* floating-point or vector load */
+    case 0x23: /* integer store */
+    case 0x27: /* floating-point or vector store */
+    case 0x2f: /* atomic memory operation */
+        return true;
+    default:
+        return false;
+    }
+}
+
 static void riscv_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
 {
     DisasContext *ctx = container_of(dcbase, DisasContext, base);
@@ -1245,6 +1260,15 @@ static void riscv_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
 
     ctx->ol = ctx->xl;
     decode_opc(env, ctx, opcode16);
+    if (mittens_sync_memory_timing_enabled() &&
+        is_mittens_memory_instruction(ctx->opcode)) {
+        /*
+         * QEMU charges a translated block's instruction count at TB entry.
+         * Timed memory hooks run inside the TB, so end it here to keep the
+         * event boundary from observing instructions that have not run yet.
+         */
+        translator_io_start(&ctx->base);
+    }
     if (is_mittens_vector_instruction(ctx->opcode, ctx->cur_insn_len)) {
         gen_helper_mittens_sync_vector_instruction();
     }
