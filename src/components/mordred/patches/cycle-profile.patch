+    cycleProfile.record(now, "state", "switch_request", index, rtrSharedObjs->needSwitchAlloc.at(vn).at(vc) != nullptr);
+    cycleProfile.record(now, "state", "tx_credit_blocked", index, !out.outBuf.empty() && out.destCredits == 0);
+  }
