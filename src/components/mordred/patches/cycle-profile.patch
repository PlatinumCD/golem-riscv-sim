+    cycleProfile.record(now, "state", "output_state", index, out.outVcState);
+    cycleProfile.record(now, "state", "destination_credits", index, out.destCredits);
+    cycleProfile.record(now, "state", "output_free_flits", index, out.outBufCredits);
+    cycleProfile.record(now, "state", "return_credits", index, in.retCredits);
