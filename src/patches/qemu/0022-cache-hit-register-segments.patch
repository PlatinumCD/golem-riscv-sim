diff --git a/target/riscv/translate.c b/target/riscv/translate.c
--- a/target/riscv/translate.c
+++ b/target/riscv/translate.c
@@ -1205,3 +1205,19 @@
 bool mittens_sync_instruction_fetch_timing_enabled(void);
 
+bool mittens_sync_register_segment_safe(CPUState *cpu);
+bool mittens_sync_register_segment_safe(CPUState *cpu)
+{
+    CPURISCVState *env = &RISCV_CPU(cpu)->env;
+    /* icount triggers use timers, not env->itrigger_enabled. Decline any
+     * configured instruction-count trigger, including a pending zero count. */
+    for (int i = 0; i < RV_MAX_TRIGGERS; ++i) {
+        if (extract64(env->tdata1[i], 60, 4) == TRIGGER_TYPE_INST_CNT)
+            return false;
+    }
+    return env->priv == PRV_M && env->misa_mxl == MXL_RV64 &&
+           !(env->mstatus & MSTATUS_MIE) && !env->itrigger_enabled &&
+           env->pmp_state.num_rules == 0 && env->mseccfg == 0 &&
+           !cpu->singlestep_enabled && QTAILQ_EMPTY(&cpu->breakpoints);
+}
+
 static void riscv_tr_init_disas_context(DisasContextBase *dcbase, CPUState *cs)
@@ -1323,7 +1323,9 @@
         translator_io_start(&ctx->base);
         gen_helper_mittens_sync_instruction_fetch(
             tcg_constant_tl(ctx->base.pc_next),
-            tcg_constant_i32(instruction_length));
+            tcg_constant_i32(instruction_length),
+            tcg_constant_i32(instruction_length == 4
+                ? translator_ldl(env, &ctx->base, ctx->base.pc_next) : opcode16));
     }
 
     ctx->ol = ctx->xl;
