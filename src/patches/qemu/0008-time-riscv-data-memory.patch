diff --git a/accel/tcg/cputlb.c b/accel/tcg/cputlb.c
index db3f93f..ae91bcf 100644
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -43,6 +43,9 @@
 #endif
 #include "tcg/tcg-ldst.h"
 #include "tcg/oversized-guest.h"
+#ifdef TARGET_RISCV
+#include "hw/misc/mittens_sync.h"
+#endif
 
 /* DEBUG defines, enable DEBUG_TLB_LOG to log to the CPU_LOG_MMU target */
 /* #define DEBUG_TLB */
@@ -1270,6 +1273,22 @@ void tlb_set_page_full(CPUState *cpu, int mmu_idx,
     tlb_set_compare(full, &tn, addr_page, write_flags,
                     MMU_DATA_STORE, prot & PAGE_WRITE);
 
+#ifdef TARGET_RISCV
+    /*
+     * The memHierarchy backend is timing-only: QEMU remains the owner of
+     * the bytes, but every guest RAM data access must enter the slow path
+     * so it can rendezvous with SST before the access completes.
+     */
+    if (is_ram && mittens_sync_memory_timing_enabled()) {
+        if (prot & PAGE_READ) {
+            tn.addr_idx[MMU_DATA_LOAD] |= TLB_FORCE_SLOW;
+        }
+        if (prot & PAGE_WRITE) {
+            tn.addr_idx[MMU_DATA_STORE] |= TLB_FORCE_SLOW;
+        }
+    }
+#endif
+
     copy_tlb_helper_locked(te, &tn);
     tlb_n_used_entries_inc(cpu, mmu_idx);
     qemu_spin_unlock(&tlb->c.lock);
@@ -1839,6 +1858,22 @@ static bool mmu_lookup(CPUState *cpu, vaddr addr, MemOpIdx oi,
         tcg_debug_assert((flags & TLB_BSWAP) == 0);
     }
 
+#ifdef TARGET_RISCV
+    if (type != MMU_INST_FETCH &&
+        mittens_sync_memory_timing_enabled() &&
+        !(l->page[0].flags & (TLB_MMIO | TLB_DISCARD_WRITE)) &&
+        (!crosspage ||
+         !(l->page[1].flags & (TLB_MMIO | TLB_DISCARD_WRITE)))) {
+        const hwaddr physical_address =
+            l->page[0].full->phys_addr +
+            (addr & ~TARGET_PAGE_MASK);
+        mittens_sync_yield_memory(
+            physical_address,
+            memop_size(l->memop),
+            type == MMU_DATA_STORE);
+    }
+#endif
+
     return crosspage;
 }
 
@@ -1943,6 +1978,15 @@ static void *atomic_mmu_lookup(CPUState *cpu, vaddr addr, MemOpIdx oi,
         }
     }
 
+#ifdef TARGET_RISCV
+    if (mittens_sync_memory_timing_enabled()) {
+        const hwaddr physical_address =
+            full->phys_addr + (addr & ~TARGET_PAGE_MASK);
+        mittens_sync_yield_memory(
+            physical_address, size, true);
+    }
+#endif
+
     return hostaddr;
 
  stop_the_world:
