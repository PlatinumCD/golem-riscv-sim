             physical_address,
             memop_size(l->memop),
-            type == MMU_DATA_STORE);
+            type == MMU_DATA_STORE,
+            mittens_sync_guest_pc(cpu, ra),
+            mittens_sync_guest_return_address(cpu));
     }
 #endif
 
