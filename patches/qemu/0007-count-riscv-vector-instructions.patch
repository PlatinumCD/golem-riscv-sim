diff --git a/target/riscv/translate.c b/target/riscv/translate.c
--- a/target/riscv/translate.c
+++ b/target/riscv/translate.c
@@ -1216,6 +1216,27 @@ static void riscv_tr_insn_start(DisasContextBase *dcbase, CPUState *cpu)
     ctx->insn_start = tcg_last_op();
 }
 
+static bool is_mittens_vector_instruction(
+    uint32_t opcode,
+    target_ulong instruction_length)
+{
+    uint32_t primary_opcode;
+    uint32_t width;
+
+    if (instruction_length != 4) {
+        return false;
+    }
+
+    primary_opcode = extract32(opcode, 0, 7);
+    if (primary_opcode == 0x57) {
+        return true;
+    }
+
+    width = extract32(opcode, 12, 3);
+    return (primary_opcode == 0x07 || primary_opcode == 0x27) &&
+           (width == 0 || width >= 5);
+}
+
 static void riscv_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
 {
     DisasContext *ctx = container_of(dcbase, DisasContext, base);
@@ -1224,6 +1245,9 @@ static void riscv_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
 
     ctx->ol = ctx->xl;
     decode_opc(env, ctx, opcode16);
+    if (is_mittens_vector_instruction(ctx->opcode, ctx->cur_insn_len)) {
+        gen_helper_mittens_sync_vector_instruction();
+    }
     ctx->base.pc_next += ctx->cur_insn_len;
 
     /* Only the first insn within a TB is allowed to cross a page boundary. */
