@@ -49,6 +49,17 @@ static bool trans_flw(DisasContext *ctx, arg_flw *a)
     decode_save_opc(ctx);
     addr = get_address(ctx, a->rs1, a->imm);
     dest = cpu_fpr[a->rd];
+    const uint32_t source_mask =
+        a->rs1 == 0 ? 0 : UINT32_C(1) << a->rs1;
+    const uint32_t destination_mask =
+        ctx->cfg_ptr->ext_zfinx && a->rd != 0
+            ? UINT32_C(1) << a->rd
+            : 0;
+    gen_helper_mittens_sync_memory_instruction(
+        tcg_constant_i32(source_mask),
+        tcg_constant_i32(destination_mask),
+        tcg_constant_i32(ctx->cur_insn_len),
+        tcg_constant_tl(ctx->base.pc_next));
     tcg_gen_qemu_ld_i64(dest, addr, ctx->mem_idx, MO_TEUL);
     gen_nanbox_s(dest, dest);
 
