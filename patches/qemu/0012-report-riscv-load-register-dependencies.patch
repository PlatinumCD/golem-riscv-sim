diff --git a/target/riscv/insn_trans/trans_rvi.c.inc b/target/riscv/insn_trans/trans_rvi.c.inc
--- a/target/riscv/insn_trans/trans_rvi.c.inc
+++ b/target/riscv/insn_trans/trans_rvi.c.inc
@@ -229,6 +229,16 @@ static bool gen_load_tl(DisasContext *ctx, arg_lb *a, MemOp memop)
 {
     TCGv dest = dest_gpr(ctx, a->rd);
     TCGv addr = get_address(ctx, a->rs1, a->imm);
+    const uint32_t source_mask =
+        a->rs1 == 0 ? 0 : UINT32_C(1) << a->rs1;
+    const uint32_t destination_mask =
+        a->rd == 0 ? 0 : UINT32_C(1) << a->rd;
+
+    gen_helper_mittens_sync_memory_instruction(
+        tcg_constant_i32(source_mask),
+        tcg_constant_i32(destination_mask),
+        tcg_constant_i32(ctx->cur_insn_len),
+        tcg_constant_tl(ctx->base.pc_next));
 
     tcg_gen_qemu_ld_tl(dest, addr, ctx->mem_idx, memop);
     gen_set_gpr(ctx, a->rd, dest);
diff --git a/target/riscv/insn_trans/trans_rvf.c.inc b/target/riscv/insn_trans/trans_rvf.c.inc
